FLASK_ENV=development
FLASK_SECRET_KEY=replace-with-your-secret
FLASK_APP=run.py

REDIS_URL=redis://default:...
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/itest?retryWrites=true&w=majority
POSTGRES_URI=postgresql+pg8000://user:pass@neon.host/itest

ICA_BASE_URL=https://auth.iglobals.com
ICA_CLIENT_ID=your-ica-client-id
ICA_CLIENT_SECRET=your-ica-client-secret
ICA_REDIRECT_URI=http://localhost:5000/auth/callback

# AI Proctoring - point at your local anticheat-system-roboflow instance while
# testing (uvicorn app.main:app --reload, default http://localhost:8000), or
# the deployed Render/Railway URL in production. PROCTOR_API_KEY must match
# one of that service's own API_KEYS values.
PROCTOR_API_BASE_URL=http://localhost:8000
PROCTOR_API_KEY=change-me-dev-key-1

FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-...
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-...

# Paystack - subscription billing (app/billing/routes.py). Add your real test
# keys directly to .env, not here. This is the ONE shared IGLOBALS HUB
# Paystack account - same key across every client app.
PAYSTACK_SECRET_KEY=sk_test_...
PAYSTACK_PUBLIC_KEY=pk_test_...

# ICA centralized webhook relay (see docs/PAYSTACK_WEBHOOK_RELAY.md in
# Iglobals-CAuth) - Paystack's own dashboard no longer points at iTest
# directly. Instead: register <your base url>/billing/webhook in the ICA
# admin panel (Settings > Clients > iTest > Payment webhooks), which hands
# you this secret one time.
ICA_WEBHOOK_RELAY_SECRET=change-me

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
